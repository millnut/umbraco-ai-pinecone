<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Umbraco.AI.Core" Version="[18.6.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.AI.Startup" Version="[18.6.0, 19.0.0)" />
    <PackageVersion Include="Pinecone.Client" Version="4.0.2" />
    <!-- Pinecone.Client brings 2.63.0, which conflicts with the Microsoft.Extensions.Http.Resilience that Umbraco
         uses (https://learn.microsoft.com/dotnet/core/resilience/http-resilience#known-issues); 2.64.0 is the fix -->
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.64.0" />

    <!-- Unit tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
